# Django
SECRET_KEY=replace-with-a-unique-django-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Deployment admin user (set these as secrets in Render)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-an-email-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your-email@example.com
SITE_URL=https://your-app.example.com

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

# Firebase public project configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Payments
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key

# Security intelligence
SHODAN_API_KEY=replace-with-shodan-api-key
SHODAN_QUERY=ssl.cert.expired:true
SHODAN_RESULTS_LIMIT=10

# Groq (GROK_API_KEY is a legacy fallback for GROQ_API_KEY)
GROQ_API_KEY=replace-with-groq-api-key
GROK_API_KEY=
# Set GROQ_MODEL to a model available to your Groq API key.
GROQ_MODEL=openai/gpt-oss-120b

# Web push
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_EMAIL=your-email@example.com

# Email delivery in production (Render blocks SMTP on the free plan)
BREVO_API_KEY=replace-with-brevo-api-key
SUPPORT_EMAIL=afolabiprosper329@gmail.com
EMAIL_TIMEOUT=15

# Official social profiles (leave blank to hide)
WHATSAPP_NUMBER=2348031234567
WHATSAPP_CHANNEL_URL=
FACEBOOK_URL=
INSTAGRAM_URL=
TIKTOK_URL=
X_URL=
YOUTUBE_URL=
LINKEDIN_URL=
